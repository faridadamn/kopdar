{
  "info": {
    "name": "KopDar API — Sprint 1",
    "description": "Complete API collection for KopDar platform. Covers Auth, Driver, and Admin endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "kopdar-team"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "driver_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "driver_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "phone_driver",
      "value": "081234567890",
      "type": "string"
    },
    {
      "key": "phone_admin",
      "value": "081111111111",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{driver_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-refresh token if expired",
          "const token = pm.collectionVariables.get('driver_token');",
          "if (!token) {",
          "  console.log('No driver_token set — some requests may fail with 401');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Body has status ok', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Register Phone",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone_driver}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('OTP sent message', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.message).to.include('OTP');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Verify OTP (Driver)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone_driver}}\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-otp"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Has tokens', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('access_token');",
                  "  pm.expect(json).to.have.property('refresh_token');",
                  "  // Save driver token for subsequent requests",
                  "  pm.collectionVariables.set('driver_token', json.access_token);",
                  "  if (json.user && json.user.id) {",
                  "    pm.collectionVariables.set('driver_id', json.user.id);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Verify OTP (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone_admin}}\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-otp"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Save admin token', function () {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('admin_token', json.access_token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone_driver}}\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Tokens returned', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('access_token');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"dGhpcyBpcyBhIHJlZnJlc2g=\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or 401', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 401]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Logout",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Clear token', function () {",
                  "  pm.collectionVariables.unset('driver_token');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Driver",
      "item": [
        {
          "name": "Register Driver (Multipart)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Budi Santoso", "type": "text" },
                { "key": "nik", "value": "3275011234567890", "type": "text" },
                { "key": "address", "value": "Jl. Mampang Prapatan No. 10, RT 05/RW 02", "type": "text" },
                { "key": "city", "value": "Jakarta Selatan", "type": "text" },
                { "key": "province", "value": "DKI Jakarta", "type": "text" },
                { "key": "vehicle_type", "value": "motor", "type": "text" },
                { "key": "vehicle_brand", "value": "Honda", "type": "text" },
                { "key": "vehicle_model", "value": "Vario 160", "type": "text" },
                { "key": "vehicle_year", "value": "2024", "type": "text" },
                { "key": "vehicle_plate", "value": "B 1234 KPD", "type": "text" },
                { "key": "vehicle_color", "value": "Hitam", "type": "text" },
                { "key": "bank_name", "value": "BCA", "type": "text" },
                { "key": "bank_account", "value": "1234567890", "type": "text" },
                { "key": "bank_holder", "value": "BUDI SANTOSO", "type": "text" },
                { "key": "platforms", "value": "[\"gojek\",\"grab\",\"shopeefood\"]", "type": "text" },
                { "key": "ktp_photo", "value": "", "type": "file", "src": [] },
                { "key": "selfie_photo", "value": "", "type": "file", "src": [] },
                { "key": "vehicle_photo", "value": "", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{base_url}}/driver/register",
              "host": ["{{base_url}}"],
              "path": ["driver", "register"]
            },
            "description": "Upload file placeholders — select actual files in Postman before running."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 or 409', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Driver Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/driver/profile",
              "host": ["{{base_url}}"],
              "path": ["driver", "profile"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Has driver fields', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('name');",
                  "  pm.expect(json).to.have.property('status');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Driver Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_color\": \"Merah\",\n  \"bank_name\": \"Mandiri\",\n  \"bank_account\": \"0987654321\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/driver/profile",
              "host": ["{{base_url}}"],
              "path": ["driver", "profile"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Driver Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/driver/status",
              "host": ["{{base_url}}"],
              "path": ["driver", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Has status field', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('status');",
                  "  pm.expect(json.status).to.be.oneOf(['pending', 'approved', 'rejected', 'suspended']);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List Pending Drivers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/drivers/pending?page=1&limit=20&city=Jakarta+Selatan",
              "host": ["{{base_url}}"],
              "path": ["admin", "drivers", "pending"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "city", "value": "Jakarta Selatan" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Has data array', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('data').that.is.an('array');",
                  "  pm.expect(json).to.have.property('meta');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Driver Details (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/drivers/{{driver_id}}",
              "host": ["{{base_url}}"],
              "path": ["admin", "drivers", "{{driver_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve Driver",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/drivers/{{driver_id}}/approve",
              "host": ["{{base_url}}"],
              "path": ["admin", "drivers", "{{driver_id}}", "approve"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or 409', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 409]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Driver",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Foto KTP tidak jelas, silakan upload ulang dengan pencahayaan yang baik\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/drivers/{{driver_id}}/reject",
              "host": ["{{base_url}}"],
              "path": ["admin", "drivers", "{{driver_id}}", "reject"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or 409', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 409]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Admin Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/stats",
              "host": ["{{base_url}}"],
              "path": ["admin", "stats"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Has stats fields', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('total_drivers');",
                  "  pm.expect(json).to.have.property('pending_drivers');",
                  "  pm.expect(json).to.have.property('approved_drivers');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
